    {
      "id": 2,
      "title": "Map",
      "description": "Mesh links from parent to device. Devices display their names; apartment-qualified IDs keep connections unique. Parent-only nodes use parent names, including the root. Edge statistics show RSSI in dBm. Map shows telemetry from the last 30 seconds; filtering devices retains their immediate parents.",
      "links": [],
      "type": "nodeGraph",
      "pluginVersion": "12.4.0",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 12
      },
      "options": {
        "edges": {
          "mainStatUnit": "dBm",
          "secondaryStatUnit": "string"
        },
        "layoutAlgorithm": "layered",
        "nodes": {
          "arcs": [],
          "mainStatUnit": ""
        },
        "zoomMode": "greedy"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "editorMode": "code",
          "exemplar": false,
          "expr": "label_join(\n  label_join(\n    label_join(\n      last_over_time(mesh_node_rssi{apartment=~\"${apartment}\",id=~\"${device}\"}[30s]),\n      \"source\", \":\", \"apartment\", \"parent\"\n    ),\n    \"target\", \":\", \"apartment\", \"id\"\n  ),\n  \"id\", \"->\", \"source\", \"target\"\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "edges",
          "hide": false,
          "interval": "15s"
        },
        {
          "editorMode": "code",
          "exemplar": false,
          "expr": "group by (id, title) (\n  label_join(\n    label_replace(\n      last_over_time(mesh_node_rssi{apartment=~\"${apartment}\",id=~\"${device}\"}[30s]),\n      \"title\", \"$1\", \"name\", \"(.+)\"\n    ),\n    \"id\", \":\", \"apartment\", \"id\"\n  )\n)\nor on (id)\ngroup by (id, title) (\n  label_join(\n    label_replace(\n      last_over_time(mesh_node_rssi{apartment=~\"${apartment}\",id=~\"${device}\"}[30s]),\n      \"title\", \"$1\", \"parent_name\", \"(.+)\"\n    ),\n    \"id\", \":\", \"apartment\", \"parent\"\n  )\n)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "refId": "nodes",
          "hide": false,
          "interval": "15s"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "filter": {
            "id": "byRefId",
            "options": "edges"
          },
          "options": {
            "include": {
              "names": [
                "id",
                "source",
                "target",
                "Value"
              ]
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "filter": {
            "id": "byRefId",
            "options": "nodes"
          },
          "options": {
            "include": {
              "names": [
                "id",
                "title"
              ]
            }
          }
        }
      ]
    },
