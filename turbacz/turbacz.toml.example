authorized = ["YOUR_AUTHORIZED_EMAIL"]
jwt_secret = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
session_secret = "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
use_mqtt = true

[mqtt]
host = "mosquitto"
port = 1883
username = "turbacz"
password = "turbacz"

[oidc]
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
allow_insecure_http = false
redirect_uri = "https://domator.example/auth"
token_endpoint_auth_method = "client_secret_post"

[psql]
dbname = "turbacz"
user = "turbacz"
password = "turbacz"
host = "postgres"
port = 5432

[server]
host = "0.0.0.0"
port = 8000

# Set to the exact proxy address if needed; do not trust arbitrary clients.
# forwarded_allow_ips = "127.0.0.1"

[security]
# Both authentication and OAuth-session cookies are Secure by default.
# For localhost HTTP only, explicitly opt in here AND in [oidc].
allow_insecure_http = false
# The host/origin from oidc.redirect_uri is also trusted. These lists add
# aliases; never use wildcards or values copied from request headers.
allowed_hosts = ["localhost", "127.0.0.1", "::1", "turbacz"]
allowed_origins = ["https://domator.example"]
# Limits apply per process. Keep one worker unless using a shared limiter.
# auth_requests_per_minute = 30
# uploads_per_minute = 5
# ws_handshakes_per_minute = 60
# ws_connections_per_user = 8
# ws_connections_per_ip = 16
# ws_messages_per_minute = 240
# ws_max_bytes = 65536
# ws_max_items = 1024
# ws_idle_seconds = 300

[monitoring]
# Used only to query heating history. Mesh, heating and host metrics are all
# exposed at /metrics and must be scraped by VictoriaMetrics/Prometheus.
metrics = "http://victoriametrics:8428"
# Export CPU, load, memory, disk, network, temperature (when the OS exposes
# it), and Turbacz process metrics at /metrics. No root access is required.
collect_host_metrics = true
# Use "host" for a native install. The Docker setup uses "container" because
# filesystem and namespace values visible to the app belong to its container.
host_metrics_scope = "container"
# Optional. The same public DSN configures both server-side and browser error
# reporting. Leave unset to disable Sentry without loading its browser SDK.
# sentry_dsn = "https://PUBLIC_KEY@YOUR_SENTRY_HOST/PROJECT_ID"
sentry_traces_sample_rate = 0.1

[firmware]
# Where uploaded OTA images are kept. Deliberately outside static/: these
# binaries embed the WiFi and MQTT credentials, so they must not be servable
# anonymously. They are handed out by GET /firmware/<device>.bin.
directory = "firmware"
# Shared secret the devices send in the X-Firmware-Token header. Must match
# CONFIG_OTA_TOKEN in uc/buttonsMeshIDF. Generate with: openssl rand -hex 32
# Leaving this empty blocks device downloads entirely.
token = ""

[ha]
# Publish lights, blinds, the heating loop and wall-button events to Home
# Assistant over MQTT Discovery. Home Assistant must use the same broker.
# See docs/home_assistant.md
enabled = false
# discovery_prefix = "homeassistant"
# base_topic = "domator"
# How often (seconds) to re-derive entities from the registry. The apply pass
# is a diff, so a run with no changes publishes nothing.
# resync_interval = 60
