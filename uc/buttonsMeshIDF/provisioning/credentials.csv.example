# NVS provisioning data for one Domator device.
#
# Copy to credentials.csv, fill in the real values, and run ./provision.sh.
# credentials.csv is gitignored -- never commit a filled-in copy.
#
# Format is the ESP-IDF NVS partition generator's: the first row opens the
# namespace, every later row is one key. Keys must match src/credentials.c.
#
key,type,encoding,value
domator,namespace,,
# --- WiFi the mesh root associates with ---
router_ssid,data,string,YOUR_WIFI_SSID
router_pass,data,string,YOUR_WIFI_PASSWORD
# --- Mesh: only the first 6 characters of mesh_id go on the wire ---
mesh_id,data,string,DMESH0
mesh_ap_pass,data,string,YOUR_MESH_AP_PASSWORD
# --- MQTT broker ---
mqtt_uri,data,string,mqtt://192.168.1.100:1883
mqtt_user,data,string,mesh_root
mqtt_pass,data,string,YOUR_MQTT_PASSWORD
# --- OTA. Optional: leave empty to disable self-update on this device. ---
# The URL is turbacz's authenticated route; the token must equal
# [firmware].token in turbacz.toml. Use switch.bin or relay.bin to match the
# board you are flashing.
ota_url,data,string,https://your-host.example/firmware/switch.bin
ota_token,data,string,YOUR_FIRMWARE_TOKEN
